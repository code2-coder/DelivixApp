# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=8085
HOST=0.0.0.0
APP_NAME=DELIVIX

# Client URLs (CORS configuration)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/delivix?retryWrites=true&w=majority
# Allow falling back to a local MongoDB if Atlas is unreachable
ALLOW_LOCAL_MONGO_FALLBACK=false

# Redis Caching (Optional - graceful fallback to memory/db when offline)
# Set ENABLE_REDIS=false to disable the client entirely.
ENABLE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# First-run administrator seeding (optional)
# The catalog seeder creates this account only when no admin exists. Use a
# strong, unique password and remove these variables after the first start.
# Existing deployments with the old demo admin must rotate that password.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary Product Image Storage (Folder: delivix/products)
# Option A: Full Cloudinary URL
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option B: Individual Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (ZeptoMail)
# Used for order lifecycle notifications (placed, confirmed, paid, shipped,
# out for delivery, delivered, cancelled, refunded, return updates).
ZEPTOMAIL_API_KEY=your_zeptomail_api_key_here
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_FROM_EMAIL=noreply@example.com
ZEPTOMAIL_FROM_NAME=Shreeharikripa

# SMS / WhatsApp notifications are not implemented in this codebase. Add a
# provider integration before enabling those channels.
# MSG91 is only used for login OTP delivery (optional in development).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8085/api/v1/auth/google/callback

# Stripe Payment Gateway (Australia & International)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Required to verify Stripe webhooks. Configure the endpoint in Stripe as:
# https://<your-api-host>/api/v1/payments/stripe/webhook
# Refunds are only marked "Completed" after Stripe confirms them; pending
# refunds remain reserved until the refund.updated / refund.failed webhook.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Razorpay Payment Gateway (India)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Required to verify Razorpay webhooks. Configure the endpoint in Razorpay as:
# https://<your-api-host>/api/v1/payments/razorpay/webhook
# Subscribe to payment.captured, payment.failed, refund.created,
# refund.processed and refund.failed so online payment/refund state is
# provider-confirmed. Without these credentials online payments are disabled
# and refunds fail closed (no fake "refunded" state is written).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Order Policy & Tax
# Number of days after delivery during which a return can be requested.
RETURN_WINDOW_DAYS=7
# Decimal tax rate applied to the item subtotal (0.03 = 3%, 0.18 = 18%).
TAX_RATE=0.03

# Invoice / Seller Details (printed on customer invoices)
COMPANY_NAME=DELIVIX
COMPANY_ADDRESS=Your registered business address
COMPANY_EMAIL=billing@example.com
COMPANY_PHONE=+91 00000 00000
COMPANY_GSTIN=
INVOICE_NOTES=Thank you for shopping with DELIVIX.

# Courier & Logistics (Delhivery)
# The current integration only checks pincode serviceability. Shipment
# creation, AWB assignment and live tracking are managed manually from
# Admin → Orders → Shipment until a fulfilment API is integrated.
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
DELHIVERY_BASE_URL=https://track.delhivery.com/c/api
DELHIVERY_ENV=production
DELHIVERY_PICKUP_LOCATION=Default

# Admin inventory alerts
LOW_STOCK_THRESHOLD=5

# Keep-Alive Configuration
KEEP_ALIVE_URL=https://shreeharikripa.onrender.com/api/health
KEEP_ALIVE_INTERVAL=10

